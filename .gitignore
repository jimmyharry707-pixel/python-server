# Project specific
data/job_tracker.db
data/job_tracker.db-*
data/notes.json
data/notes.unreadable-*.json
data/prev.json
data/screening_log.json
data/sync_state.json
deploy/data/
server/data/avatars/
# Daily review scan uploads (candidate data; deleted when a scan closes)
server/data/scans/
resumes/

# Generated splash image (regenerated by make_splash.py during build)
splash.png
# Generated Windows version resource (written by build_exe.py)
file_version_info.txt

# Logs and temporary files
logs/
*.log
*.tmp
*.temp

# Secrets / environment (keep *.example tracked)
.env
.env.*
!.env.example
!**/.env.example
backups/
*.pem
*.key
secrets/
credentials.json
**/service-account*.json

# TLS certs for nginx (keep baymax.conf tracked; never commit real certs)
server/nginx/certs/*
!server/nginx/certs/.gitkeep

# User-portal release binaries (served by nginx; uploaded via admin)
server/nginx/userportal/downloads/*
!server/nginx/userportal/downloads/.gitkeep

# Local runtime / identity / credentials (desktop client)
config/baymax_credentials.json
config/device_id
config/consent.json
config/server_managed.json
config/preferences.json
config/profiles/*.json
config/candidate_briefs.json
config/screening_rules.json

# Local / server databases
*.db
*.db-journal
*.sqlite
*.sqlite3
server/baymax_server.db
server/profiles/
server/themes/

# Test files
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebook
.ipynb_checkpoints

