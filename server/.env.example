# Copy to server/.env (dev) or provide as environment variables (prod).

# development | staging | production
BAYMAX_ENVIRONMENT=development

# SQLite for local/dev only. REQUIRED Postgres in production for concurrent sync:
#   postgresql+psycopg://baymax:password@db:5432/baymax
# Relative sqlite paths are resolved under the server/ directory.
BAYMAX_DATABASE_URL=sqlite:///./baymax_server.db

# REQUIRED in prod - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BAYMAX_JWT_SECRET=dev-insecure-change-me
BAYMAX_ACCESS_TOKEN_TTL_MINUTES=15
BAYMAX_DESKTOP_ACCESS_TOKEN_TTL_MINUTES=60

# Sign-in sessions: ended by idle time or the hard limit, whichever is first.
BAYMAX_SESSION_IDLE_DAYS=7
BAYMAX_SESSION_SHORT_IDLE_HOURS=12
BAYMAX_SESSION_MAX_DAYS=14
BAYMAX_SESSION_STAFF_MAX_DAYS=7

# ----- Licensing (Ed25519 signed leases) -----
# Offline lease length in days (client must refresh online before this elapses).
BAYMAX_LICENSE_LEASE_TTL_DAYS=7

# Pepper mixed into license-key hashes. REQUIRED unique value in production.
BAYMAX_LICENSE_KEY_PEPPER=dev-license-pepper-change-me

# Key id stamped into lease JWT headers (for rotation).
BAYMAX_LICENSE_SIGNING_KID=baymax-lic-1

# PKCS8 PEM of the Ed25519 private signing key.
# Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k=Ed25519PrivateKey.generate(); print(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode())"
# In .env, replace real newlines with the two-character sequence \n.
# Leave empty in development to use the insecure fixed seed (client public key must match).
# BAYMAX_LICENSE_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Optional JSON map of kid -> SubjectPublicKeyInfo PEM (for verifying rotated keys).
# Leave empty to publish only the active signing key's public half.
# BAYMAX_LICENSE_PUBLIC_KEYS={"baymax-lic-1":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"}

# Sidekick and SnowLink sign their leases with their own keys (same format as
# BAYMAX_LICENSE_SIGNING_KEY, generate one per app). Until an app's key is set,
# production refuses to activate that app's keys (HTTP 503); CareerCraft is
# unaffected. Their public halves go into the app builds: see
# docs/licensing/ADMIN_LICENSES.md.
# BAYMAX_LICENSE_SIGNING_KEY_SIDEKICK=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# BAYMAX_LICENSE_SIGNING_KID_SIDEKICK=sidekick-lic-1
# BAYMAX_LICENSE_SIGNING_KEY_SNOWLINK=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# BAYMAX_LICENSE_SIGNING_KID_SNOWLINK=snowlink-lic-1

# Rate limit for license activate/refresh/release, all apps (per IP per minute)
BAYMAX_LICENSE_RATE_LIMIT_PER_MINUTE=20

# Comma-separated CORS origins for the admin dashboard / web app.
# Do NOT use "*" in production (credentials require explicit origins).
BAYMAX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Bootstrap admin (created only if the users table is empty)
BAYMAX_BOOTSTRAP_ADMIN_EMAIL=admin@baymax.example.com
BAYMAX_BOOTSTRAP_ADMIN_PASSWORD=changeme-admin
BAYMAX_BOOTSTRAP_ADMIN_NAME=Administrator

# Directory for CareerCraft.exe / TekAbsurd_cert.cer (admin CC Releases uploads).
# Empty = server/nginx/userportal/downloads. Docker compose sets this explicitly.
# BAYMAX_RELEASE_FILES_DIR=/data/userportal-downloads

# docker-compose only
POSTGRES_PASSWORD=baymax

