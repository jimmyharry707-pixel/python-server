{
  "name": "baymax-stage-web",
  "version": "0.1.0",
  "private": true,
  "description": "Absurd Technologies web UI (Tabler + Vite) served at app root",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:production-backend": "vite --mode production-backend",
    "build": "vite build",
    "preview": "vite preview",
    "baseline:capture": "node scripts/capture-ui-baseline.mjs",
    "format": "prettier --write \"src/react/**/*.{ts,tsx}\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/react/**/*.{ts,tsx}\" \"*.{js,json,html}\""
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@hookform/resolvers": "^5.8.0",
    "@tabler/core": "^1.4.0",
    "@tabler/icons-webfont": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "flag-icons": "^7.5.0",
    "jsvectormap": "^1.7.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  }
}
